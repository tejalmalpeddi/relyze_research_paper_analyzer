# Copy this file to .env and fill in your own values.
# Never commit .env — it's gitignored.

# Required for Supabase (history routes)
SUPABASE_URL=your-supabase-url-here
SUPABASE_KEY=your-supabase-key-here

# Optional: enables AI subcategory generation (POST /api/subcategories/generate)
# Get a free key at https://console.groq.com
# Without this, the endpoint returns a placeholder node.
GROQ_API_KEY=your-groq-key-here

# Required on Apple Silicon (M1/M2/M3/...) for PDF import to work at all.
# Docling compiles its layout model with torch.compile by default, and
# PyTorch's inductor backend doesn't support the "mps" device -- every PDF
# import crashes with a LoweringException without this set to false.
DOCLING_INFERENCE_COMPILE_TORCH_MODELS=false
